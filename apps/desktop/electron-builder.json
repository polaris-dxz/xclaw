{
  "appId": "com.xclaw.app",
  "productName": "xclaw",
  "publish": {
    "provider": "github",
    "owner": "polaris-dxz",
    "repo": "xclaw"
  },
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "preload-subtitle.js",
    "subtitle-overlay.html",
    "package.json",
    "node_modules/electron-updater/**/*"
  ],
  "extraResources": [
    {
      "from": "../web/out",
      "to": "web/out"
    },
    {
      "from": "openclaw-runtime",
      "to": "openclaw",
      "filter": [
        "config/**/*",
        "node_modules/**/*",
        "package.json",
        "package-lock.json"
      ]
    },
    {
      "from": "../studio-api",
      "to": "studio-api",
      "filter": [
        "apps/**/*",
        "assets/**/*",
        "config/**/*",
        "*.json",
        "requirements.txt",
        "uv.lock",
        "pyproject.toml"
      ]
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "zip"],
    "icon": "public/icon.icns"
  },
  "win": {
    "target": ["nsis"],
    "icon": "public/icon.ico"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Development"
  }
}
